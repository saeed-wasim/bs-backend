DB_HOST=localhost
DB_PORT=3306
DB_NAME=bin_saleem_jewellery
DB_USER=root
DB_PASSWORD=

BACKEND_PORT=3001

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Set to true to re-enable JWT enforcement on write endpoints
REQUIRE_AUTH=false

# bs-user (storefront) URL — used for Stripe Checkout success/cancel redirects
FRONTEND_URL=http://localhost:4000

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys) — safe, no real charges
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
# From `stripe listen --forward-to localhost:3001/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=usd

# Must match the client ID used by the frontend's Google Sign-In button
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
