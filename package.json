{
  "name": "bs-backend",
  "version": "1.0.0",
  "description": "Shared Express + Sequelize + MySQL backend for bin-saleem-jewellery (admin) and bs-user (storefront)",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "import:legacy-data": "node scripts/import-legacy-data.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.1",
    "sequelize": "^6.37.8",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
